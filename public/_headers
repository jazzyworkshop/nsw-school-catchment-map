# Global Rules for All Pages
/*
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Permitted-Cross-Domain-Policies: none
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.openstreetmap.org https://*.mapbox.com; connect-src 'self' https://nominatim.openstreetmap.org https://*.openstreetmap.org https://*.tiles.mapbox.com https://api.mapbox.com;

# Rules for your root JSON map datasets (schools_master.json, etc.)
/*.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=600

# Rules if you use a specific nested data subdirectory
/data/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=600