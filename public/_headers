# Global Rules for All Pages
/*
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Permitted-Cross-Domain-Policies: none
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
 Content-Security-Policy: default-src * 'unsafe-inline' 'unsafe-eval' data: blob:; script-src * 'unsafe-inline' 'unsafe-eval'; connect-src * 'unsafe-inline'; img-src * data: blob:; style-src * 'unsafe-inline';

# Rules for your root JSON map datasets
/*.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=600

# Rules if you use a specific nested data subdirectory
/data/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=600